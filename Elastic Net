def neuroCombatFromTraining_fixed(dat, batch, estimates):

    batch = np.array(batch, dtype="str")
    new_levels = np.unique(batch)
    old_levels = np.array(estimates["batches"], dtype="str")
    missing_levels = np.setdiff1d(new_levels, old_levels)
    if missing_levels.shape[0] != 0:
        raise ValueError(
            "The batches " + str(missing_levels) +
            " are not part of the training dataset"
        )

    wh = [
        int(np.where(old_levels == x)[0][0]) if x in old_levels else None
        for x in batch
    ]

    var_pooled = estimates["var.pooled"]
    stand_mean = estimates["stand.mean"][:, 0]
    mod_mean = estimates["mod.mean"]
    gamma_star = estimates["gamma.star"]
    delta_star = estimates["delta.star"]
    n_array = dat.shape[1]
    stand_mean = stand_mean + mod_mean.mean(axis=1)

    stand_mean = np.transpose([stand_mean, ] * n_array)
    bayesdata = np.subtract(dat, stand_mean) / np.sqrt(var_pooled)

    gamma = np.transpose(gamma_star[wh, :])
    delta = np.transpose(delta_star[wh, :])
    bayesdata = np.subtract(bayesdata, gamma) / np.sqrt(delta)

    bayesdata = bayesdata * np.sqrt(var_pooled) + stand_mean

    return {"data": bayesdata, "estimates": estimates}


class MissingnessColumnFilter(BaseEstimator, TransformerMixin):
    """Drop columns whose missing-value fraction exceeds `threshold`,
    computed only from the fold this transformer is fit on."""

    def __init__(self, threshold=0.30):
        self.threshold = threshold

    def fit(self, X, y=None):
        X = pd.DataFrame(X)
        missing_frac = X.isnull().mean()
        self.keep_cols_ = missing_frac[missing_frac < self.threshold].index.tolist()
        return self

    def transform(self, X):
        return pd.DataFrame(X)[self.keep_cols_]


class ConstantColumnFilter(BaseEstimator, TransformerMixin):
    """Drop columns with <= 1 unique value in the fold this
    transformer is fit on."""

    def fit(self, X, y=None):
        X = pd.DataFrame(X)
        nunique = X.nunique(dropna=True)
        self.keep_cols_ = nunique[nunique > 1].index.tolist()
        return self

    def transform(self, X):
        return pd.DataFrame(X)[self.keep_cols_]


class ComBatHarmonizer(BaseEstimator, TransformerMixin):


    def __init__(self, covars, batch_col, categorical_cols=None, continuous_cols=None):
        # `covars` is the FULL covariate lookup table (indexed like
        # the full X_mri), not a fold-specific slice.
        self.covars = covars
        self.batch_col = batch_col
        self.categorical_cols = categorical_cols
        self.continuous_cols = continuous_cols

    def fit(self, X, y=None):
        X = pd.DataFrame(X)
        covars_fold = self.covars.loc[X.index]

        result = neuroCombat(
            dat=X.T,
            covars=covars_fold,
            batch_col=self.batch_col,
            categorical_cols=self.categorical_cols or [],
            continuous_cols=self.continuous_cols or [],
        )

        self.estimates_ = result["estimates"]
        self.columns_ = X.columns
        self._train_index_ = X.index
        # Cache the exact harmonized training fold so fit_transform
        # (called on the training fold) doesn't need to re-derive it
        # through the approximate out-of-sample path.
        self._train_harmonized_ = pd.DataFrame(
            result["data"].T, index=X.index, columns=X.columns
        )
        self._fallback_median_ = self._train_harmonized_.median()
        return self

    def transform(self, X):
        X = pd.DataFrame(X)

        if X.index.equals(self._train_index_):
            harmonized = self._train_harmonized_
        else:
            covars_fold = self.covars.loc[X.index]
            batch = covars_fold[self.batch_col]
            out = neuroCombatFromTraining_fixed(
                dat=X.T.values,
                batch=batch.values,
                estimates=self.estimates_,
            )
            harmonized = pd.DataFrame(out["data"].T, index=X.index, columns=X.columns)

        # Safety net: fall back to the training fold's medians for any
        # non-finite values the out-of-sample step produces.
        harmonized = harmonized.replace([np.inf, -np.inf], np.nan)
        harmonized = harmonized.fillna(self._fallback_median_)
        return harmonized


# =========================================================
# CROSS VALIDATION
# =========================================================
# Stratified on Site (not the regression target) and materialized as
# precomputed folds. This guarantees every fold's TRAINING split
# contains every site level, which ComBatHarmonizer's per-fold fit
# needs -- otherwise a fold could hold out a site's only subjects and
# `neuroCombatFromTraining` would have no estimates for that batch.

site_labels = df["Site"].astype(str)

cv_splitter = RepeatedStratifiedKFold(

    n_splits=5,

    n_repeats=10,

    random_state=42

)

cv_splits = list(cv_splitter.split(X_mri, site_labels))

# =========================================================
# ELASTIC NET PIPELINE (fully leakage-safe)
# =========================================================

X = X_mri

pipeline = Pipeline([

    ("missingness_filter", MissingnessColumnFilter(threshold=0.30)),

    ("imputer", SimpleImputer(strategy="median")),

    ("combat", ComBatHarmonizer(
        covars=combat_covars,
        batch_col="Site",
        categorical_cols=["Sex"],
        continuous_cols=["Age"],
    )),

    ("constant_filter", ConstantColumnFilter()),

    ("scaler", StandardScaler()),

    ("elasticnet", ElasticNetCV(

        l1_ratio=[
            0.1, 0.3, 0.5, 0.7, 0.9, 0.95, 0.99, 1.0
        ],

        alphas=np.logspace(-4, 5, 150),

        cv=3,

        max_iter=50000,

        random_state=42,

        n_jobs=-1

    ))

])

# =========================================================
# CROSS-VALIDATED PERFORMANCE
# =========================================================

scores = cross_val_score(

    pipeline,

    X,

    y,

    cv=cv_splits,

    scoring="r2",

    error_score="raise"

)

