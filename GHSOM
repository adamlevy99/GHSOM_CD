    def write_layer2_cluster_summary(
            self,
            struct,
            features,
            outpath="Results/Layer2_Cluster_Summary.xlsx"
    ):

        labels = self.df_clean["ID"].astype(str).values

        root = struct["root_map"]

        root_bmus = root["bmus"]
        children = root["children"]

        rows = []

        X = features.values

        # =====================================================
        # BUILD LAYER-2 ASSIGNMENTS
        # =====================================================

        for root_unit, child in enumerate(children):

            member_idx = np.where(root_bmus == root_unit)[0]

            if len(member_idx) == 0:
                continue

            # ---------------------------------------------
            # No child SOM
            # ---------------------------------------------
            if child is None:

                for idx in member_idx:
                    sid = labels[idx]

                    rows.append({
                        "ID": sid,
                        "RootCluster": root_unit,
                        "Layer2Cluster": np.nan,
                        "FullCluster": f"{root_unit}"
                    })

                continue

            # ---------------------------------------------
            # Child SOM exists
            # ---------------------------------------------
            child_cb = child["codebook"]

            Xsub = X[member_idx]

            d2 = np.sum(
                (Xsub[:, None, :] - child_cb[None, :, :]) ** 2,
                axis=2
            )

            child_bmus = np.argmin(d2, axis=1)

            for local_idx, child_unit in enumerate(child_bmus):
                global_idx = member_idx[local_idx]

                sid = labels[global_idx]

                rows.append({
                    "ID": sid,
                    "RootCluster": root_unit,
                    "Layer2Cluster": int(child_unit),
                    "FullCluster": f"{root_unit}.{child_unit}"
                })

        df_assign = pd.DataFrame(rows)

        # =====================================================
        # MERGE METADATA + FEATURES
        # =====================================================

        df = (
            df_assign
            .merge(self.df_metadata, on="ID", how="left")
            .merge(self.df_clean, on="ID", how="left")
        )

        # =====================================================
        # VARIABLES
        # =====================================================

        neuropsych_vars = [

            c for c in self.df_clean.columns

            if c not in ["ID", "IQ"]

        ]

        clinical_vars = [

            "CD_total",
            "Callousness",
            "ODD",
            "ADHD",
            "Depression",
            "Anxiety",
            "PTSD",
            "OCD",
            "Internalising_bin"

        ]

        summary_rows = []

        # =====================================================
        # GROUP BY FULLCLUSTER
        # =====================================================

        for clust, sub in df.groupby("FullCluster"):

            row = {

                "FullCluster": clust,

                "N": len(sub)

            }

            # ---------------------------------------------
            # Neuropsych means
            # ---------------------------------------------

            for var in neuropsych_vars:
                row[f"Mean_{var}"] = sub[var].mean()

            # ---------------------------------------------
            # Clinical vars
            # ---------------------------------------------

            for var in clinical_vars:

                if var not in sub.columns:
                    continue

                if sub[var].dropna().isin([0, 1]).all():

                    row[f"{var}_%"] = (
                            sub[var].mean() * 100
                    )

                else:

                    row[f"Mean_{var}"] = sub[var].mean()

            # ---------------------------------------------
            # Demographics
            # ---------------------------------------------

            row["Mean_Age"] = sub["Age"].mean()

            row["Mean_IQ"] = sub["IQ"].mean()

            sex_counts = (
                    sub["Sex"]
                    .value_counts(normalize=True)
                    * 100
            )

            row["Male_%"] = sex_counts.get(2, 0)

            row["Female_%"] = sex_counts.get(1, 0)

            # ---------------------------------------------
            # Group composition
            # ---------------------------------------------

            group_counts = (
                    sub["Group"]
                    .value_counts(normalize=True)
                    * 100
            )

            row["CD_%"] = group_counts.get("CD", 0)

            row["Control_%"] = group_counts.get("Control", 0)

            summary_rows.append(row)

        summary_df = pd.DataFrame(summary_rows)

        # =====================================================
        # SAVE
        # =====================================================

        summary_df.to_excel(outpath, index=False)

        print(summary_df)

        logging.info(
            f"Layer2 cluster summary written -> {outpath}"
        )

        return summary_df

    def _plot_spider_profiles_layer1(
            self,
            features: pd.DataFrame,
            clusters: Dict[int, List[str]]
    ):

        import os

        os.makedirs("Results", exist_ok=True)

        print("df_clean ID sample:", self.df_clean['ID'].head().values)
        print("l1_clusters sample:", {k: v[:3] for k, v in list(clusters.items())[:5]})
        print("df_clean shape:", self.df_clean.shape)

        # ---------------------------------------------------
        # Force IDs to strings
        # ---------------------------------------------------
        id2idx = {
            str(id_): i
            for i, id_ in enumerate(self.df_clean['ID'])
        }

        cols = features.columns.tolist()

        N = len(cols)

        angles = np.linspace(
            0,
            2 * np.pi,
            N,
            endpoint=False
        ).tolist()

        angles += angles[:1]

        # ---------------------------------------------------
        # Color palette for clusters
        # ---------------------------------------------------
        cluster_colors = {
            0: "#1f77b4",  # blue
            1: "#ff7f0e",  # orange
            2: "#2ca02c",  # green
            3: "#d62728",  # red
        }

        # ---------------------------------------------------
        # Loop over clusters
        # ---------------------------------------------------
        for unit, ids in clusters.items():

            try:

                idxs = [
                    id2idx[str(i)]
                    for i in ids
                    if str(i) in id2idx
                ]

                print(
                    f"Cluster {unit}: "
                    f"{len(ids)} total, "
                    f"{len(idxs)} matched in df_clean"
                )

                if len(idxs) < 2:
                    print(f"Skipping cluster {unit} (<2 participants)")
                    continue

                # ---------------------------------------------------
                # Compute mean profile
                # ---------------------------------------------------
                vals = features.iloc[idxs].mean(axis=0).values

                vals = np.nan_to_num(
                    vals,
                    nan=0.0,
                    posinf=0.0,
                    neginf=0.0
                )

                vals = vals.tolist()
                vals += vals[:1]

                # ---------------------------------------------------
                # Cluster display name (1-4 instead of 0-3)
                # ---------------------------------------------------
                display_cluster = unit + 1

                # ---------------------------------------------------
                # Cluster color
                # ---------------------------------------------------
                color = cluster_colors.get(unit, "#333333")

                # ---------------------------------------------------
                # Plot
                # ---------------------------------------------------
                fig, ax = plt.subplots(
                    figsize=(8, 8),
                    subplot_kw={'polar': True}
                )

                ax.plot(
                    angles,
                    vals,
                    linewidth=3,
                    color=color,
                    label=f"Cluster {display_cluster}"
                )

                ax.fill(
                    angles,
                    vals,
                    color=color,
                    alpha=0.25
                )

                # ---------------------------------------------------
                # Cleaner feature labels
                # ---------------------------------------------------
                pretty_cols = [
                    c.replace("_", " ").title()
                    for c in cols
                ]

                ax.set_thetagrids(
                    np.degrees(angles[:-1]),
                    pretty_cols,
                    fontsize=10
                )

                # Improve spacing of labels
                ax.tick_params(axis='x', pad=12)

                # Radial axis formatting
                ax.set_ylim(-2, 3)

                ax.set_yticks([-2, -1, 0, 1, 2, 3])

                ax.set_yticklabels(
                    ['-2', '-1', '0', '1', '2', '3'],
                    fontsize=9
                )

                # Grid styling
                ax.grid(
                    True,
                    linestyle='--',
                    alpha=0.5
                )

                # Title
                ax.set_title(
                    f"Root Cluster {display_cluster}",
                    fontsize=16,
                    fontweight='bold',
                    y=1.12
                )

                # Optional legend
                ax.legend(
                    loc='upper right',
                    bbox_to_anchor=(1.2, 1.1)
                )

                outfile = f"Results/spider_L1_cluster_{display_cluster}.png"

                print(f"Saving spider plot -> {outfile}")

                plt.savefig(
                    outfile,
                    bbox_inches="tight",
                    dpi=300
                )

                plt.close()

                print(f"Saved: {outfile}")

            except Exception as e:

                print(
                    f"Spider plot failed for cluster "
                    f"{unit}: {e}"
                )

