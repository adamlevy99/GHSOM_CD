    def bootstrap_stability(
            self,
            data: pd.DataFrame,
            breadth: float,
            depth: float,
            n_boot: int = 10,
            outpath: str = "Results/GHSOM_Stability.xlsx"
    ):

        logging.info("Running bootstrap stability analysis...")

        # ---------------------------------------------------------
        # ORIGINAL MODEL
        # ---------------------------------------------------------
        original = self.train_ghsom(
            data.drop(columns=["ID"], errors="ignore"),
            breadth,
            depth,
            data["ID"].values

        )

        original_labels = original["root_map"]["bmus"]

        # ---------------------------------------------------------
        # STORAGE
        # ---------------------------------------------------------
        ari_rows = []
        size_rows = []
        assign_rows = []
        # ---------------------------------------------------------
        # BOOTSTRAP LOOP
        # ---------------------------------------------------------
        for b in range(n_boot):
            logging.info(
                f"Bootstrap {b + 1}/{n_boot}"
            )

            # -----------------------------------------------------
            # RESAMPLE PARTICIPANTS
            # -----------------------------------------------------
            sample_idx = np.random.choice(
                len(data),
                len(data),
                replace=True

            )

            boot = (
                data
                .iloc[sample_idx]
                .reset_index(drop=True)
            )

            # -----------------------------------------------------
            # TRAIN GHSOM
            # -----------------------------------------------------
            boot_result = self.train_ghsom(

                boot.drop(
                    columns=["ID"],
                    errors="ignore"
                ),

                breadth,
                depth,
                boot["ID"].values

            )

            boot_labels = (
                boot_result["root_map"]["bmus"]
            )

            # -----------------------------------------------------
            # COMPUTE ARI
            # -----------------------------------------------------
            ari = adjusted_rand_score(
                original_labels[sample_idx],
                boot_labels

            )

            ari_rows.append({
                "Bootstrap": b + 1,
                "ARI": ari
            })

            # -----------------------------------------------------
            # SAVE CLUSTER SIZES
            # -----------------------------------------------------
            unique, counts = np.unique(
                boot_labels,
                return_counts=True
            )

            row = {

                "Bootstrap": b + 1
            }

            for u, c in zip(unique, counts):
                row[f"Cluster_{u}_N"] = c

            size_rows.append(row)

            # -----------------------------------------------------
            # SAVE PARTICIPANT ASSIGNMENTS
            # -----------------------------------------------------
            boot_ids = boot["ID"].values
            for sid, clust in zip(
                    boot_ids,
                    boot_labels
            ):
                assign_rows.append({

                    "Bootstrap": b + 1,
                    "ID": sid,
                    "Cluster": int(clust)
                })

        # ---------------------------------------------------------
        # DATAFRAMES
        # ---------------------------------------------------------
        ari_df = pd.DataFrame(ari_rows)
        size_df = pd.DataFrame(size_rows)
        assign_df = pd.DataFrame(assign_rows)

        # ---------------------------------------------------------
        # PARTICIPANT STABILITY SUMMARY
        # ---------------------------------------------------------
        stability_df = (
            assign_df
            .groupby("ID")["Cluster"]
            .agg([
                ("N_Clusters", "nunique"),
                ("Most_Common_Cluster",
                 lambda x: x.mode()[0])
            ])
            .reset_index()

        )

        # participant-level stability
        participant_stability = (
            assign_df
            .groupby("ID")["Cluster"]
            .agg(lambda x: (x == x.mode()[0]).mean())
            .reset_index(name="Participant_Stability")
        )

        # original cluster membership
        original_cluster_df = pd.DataFrame({
            "ID": data["ID"].values,
            "Original_Cluster": original_labels
        })

        # merge
        participant_stability = participant_stability.merge(
            original_cluster_df,
            on="ID"
        )

        # average stability per cluster
        cluster_stability_df = (
            participant_stability
            .groupby("Original_Cluster")["Participant_Stability"]
            .mean()
            .reset_index(name="Average_Cluster_Stability")
        )

        # ---------------------------------------------------------
        # SUMMARY STATS
        # ---------------------------------------------------------
        summary_df = pd.DataFrame([{

            "Mean_ARI": ari_df["ARI"].mean(),
            "SD_ARI": ari_df["ARI"].std(),
            "Min_ARI": ari_df["ARI"].min(),
            "Max_ARI": ari_df["ARI"].max()

        }])

        # ---------------------------------------------------------
        # SAVE HISTOGRAM
        # ---------------------------------------------------------
        plt.figure(figsize=(6, 4))
        plt.hist(
            ari_df["ARI"],
            bins=20

        )

        plt.xlabel("ARI")
        plt.ylabel("Frequency")
        plt.title("Bootstrap Stability")
        plt.tight_layout()
        plt.savefig(
            "Results/ARI_Distribution.png",
            dpi=150

        )

        plt.close()

        # ---------------------------------------------------------
        # EXPORT EXCEL
        # ---------------------------------------------------------


        with pd.ExcelWriter(outpath) as writer:
            ari_df.to_excel(
                writer,
                sheet_name="Bootstrap_ARI",
                index=False

            )

            summary_df.to_excel(
                writer,
                sheet_name="Summary",
                index=False

            )

            size_df.to_excel(
                writer,
                sheet_name="Cluster_Sizes",
                index=False

            )

            assign_df.to_excel(
                writer,
                sheet_name="Assignments",
                index=False

            )

            stability_df.to_excel(
                writer,
                sheet_name="Participant_Stability",
                index=False

            )

            cluster_stability_df.to_excel(
                writer,
                sheet_name="Cluster_Stability",
                index=False
            )

        logging.info(
            f"Stability results written -> {outpath}"

        )

        return {

            "ari_scores": ari_df,
            "summary": summary_df,
            "assignments": assign_df,
            "participant_stability": stability_df,
            "cluster_stability": cluster_stability_df

        }

