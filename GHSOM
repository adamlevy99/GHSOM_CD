class SOMAnalysis:
    def __init__(self, data_dir: str = "Updated_DATA", n_jobs: int = None, seed: int = 42):
        self.data_dir = Path(data_dir)
        self.setup_directories()
        self.n_jobs = n_jobs or os.cpu_count()
