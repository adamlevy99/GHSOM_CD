    def run_analysis(
            self,
            data: pd.DataFrame,
            breadth: float,
            depth: float,
            bootsze: int = 100
    ) -> Dict[str, Any]:

        self.df_clean = data.copy()

        logging.info(f"Using seed = {self.seed}")

        labels = data['ID'].values

        features = data.drop(
            columns=['ID'],
            errors='ignore'
        )

        # ------------------------------------
        # Basic plots FIRST
        # ------------------------------------
        logging.info("Generating descriptive plots...")

        self._plot_histograms(features)

        self._plot_boxplots(features)

        self._plot_correlation_heatmap(features)

        # ------------------------------------
        # Train GHSOM
        # ------------------------------------
        logging.info("Training GHSOM...")

        struct = self.train_ghsom(
            features,
            breadth,
            depth,
            labels
        )

        self.ghsom_struct = struct

        # ------------------------------------
        # Root clusters
        # ------------------------------------
        l1 = self._extract_layer1_clusters(
            struct,
            labels
        )

        self.l1_clusters = l1
        self.root_clusters = l1



        # ------------------------------------
        # Spider plots
        # ------------------------------------
        self._plot_spider_profiles_layer1(
            features,
            l1
        )

        # ------------------------------------
        # Export graph
        # ------------------------------------
        self.export_ghsom_to_gexf(
            struct['root_map'],
            path='Results/ghsom_root.gexf'
        )

        # ------------------------------------
        # Return results
        # ------------------------------------
        return {
            "ghsom_structure": struct,
            "root_clusters": l1,
        }

