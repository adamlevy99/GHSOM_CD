        Path("Layer2").mkdir(exist_ok=True)
        Path("Results").mkdir(exist_ok=True)

    def preprocess_data(
            self,
            only_cd: bool = True,
            site_normalization: bool = True
    ) -> pd.DataFrame:
        """
        Load, clean, and harmonize neurocognitive variables using neuroCombat.

        Site effects are removed from neurocognitive features while preserving
        biological variance associated with demographic and clinical covariates.

        Clinical variables are not harmonized and are not used for clustering,
        but are retained in metadata for downstream statistical analyses.
        """

        try:

            # ============================================================
            # LOAD DATA
            # ============================================================

            data_path = "/Users/adaml/Desktop/CODE/Data/FemNAT_Neuro_psych_main.csv"
            df_raw = pd.read_csv(data_path)

            ids = df_raw['ID'].astype(str)
            onset_series = df_raw['CD_OnsetType']

            # ============================================================
            # PAL MERGE
            # ============================================================

            pal_cols = [
                "PAL_ZRE_1_9to12_girls",
                "PAL_ZRE_1_9to12_boys",
                "PAL_ZRE_1_13to15_girls",
                "PAL_ZRE_1_13to15_boys",
                "PAL_ZRE_1_16to18_girls",
                "PAL_ZRE_1_16to18_boys"
            ]

            df_raw[pal_cols] = df_raw[pal_cols].replace(r"^\s*$", np.nan, regex=True)
            df_raw[pal_cols] = df_raw[pal_cols].replace({0: np.nan, 1: np.nan})

            df_raw["PAL"] = df_raw[pal_cols].apply(
                lambda row: row.dropna().iloc[0] if row.dropna().size > 0 else np.nan,
                axis=1
            )

            # ============================================================
            # RENAME COGNITIVE VARIABLES
            # ============================================================

            df_raw.rename(columns={
                'Anger_ACC': 'Anger',
                'Disgust_ACC': 'Disgust',
                'Fear_ACC': 'Fear',
                'Happy_ACC': 'Happiness',
                'Sad_ACC': 'Sadness',
                'Surprise_ACC': 'Surprise',
                'eIQ_total': 'IQ'
            }, inplace=True)

            # ============================================================
            # D-PRIME COMPUTATION
            # ============================================================

            rate_cols = [
                'FArate_EmoControl_RES', 'HitRate_EmoControl_RES',
                'FArate_CogControl_RES', 'HitRate_CogControl_RES'
            ]

            for col in rate_cols:
                df_raw[col] = pd.to_numeric(df_raw[col], errors='coerce')

            def _compute_dprime(hit, fa, eps=1e-5):
                hr = np.clip(hit, eps, 1 - eps)
                fr = np.clip(fa, eps, 1 - eps)
                return norm.ppf(hr) - norm.ppf(fr)

            df_raw['Emotive Control'] = _compute_dprime(
                df_raw['HitRate_EmoControl_RES'],
                df_raw['FArate_EmoControl_RES']
            )

            df_raw['Cognitive Control'] = _compute_dprime(
                df_raw['HitRate_CogControl_RES'],
                df_raw['FArate_CogControl_RES']
            )

            # ============================================================
            # SELECT NEUROCOGNITIVE VARIABLES
            # ============================================================

            selected_columns = [
                'Anger', 'Disgust', 'Fear', 'Happiness',
                'Sadness', 'Surprise',
                'Sex', 'Age', 'centre', 'IQ',
                'PAL',
                'Emotive Control', 'Cognitive Control'
            ]

            df_subset = df_raw[selected_columns].replace('', np.nan)
            df_subset = df_subset.apply(pd.to_numeric, errors='coerce')

            df_subset = df_subset.loc[:, df_subset.nunique() > 1]
            df_subset = df_subset.dropna(subset=['Sex', 'centre']).dropna()

            # Preserve IDs + onset
            df_subset['ID'] = ids.loc[df_subset.index].values
            df_subset['CD_OnsetType'] = onset_series.loc[df_subset.index].values

            # ============================================================
            # MERGE CLINICAL VARIABLES
            # ============================================================

            clinical_cols = [
                'CD_items_current_Aggression_sum',
                'CD_items_current_Destruction_sum',
                'CD_items_current_RuleViolation_sum',
                'CD_items_current_DeceitfulnessTheft_sum',
                'ICU_IMPUTED_total_sum_imp',
                'ODD_items_fulfilled_current',
                'ADHD_current_Impulsivity_Hyperactivity_count',
                'KSLDC_DIAG_Dep_acute',
                'KSLDC_DIAG_Anx_acute',
                'KSLDC_DIAG_PTSD_acute',
                'KSLDC_DIAG_OCD_acute'
            ]

            clinical_df = df_raw[['ID'] + clinical_cols].copy()
            clinical_df['ID'] = clinical_df['ID'].astype(str)

            for col in clinical_cols:
                clinical_df[col] = pd.to_numeric(clinical_df[col], errors='coerce')

            # CD TOTAL
            clinical_df['CD_total'] = clinical_df[
                [
                    'CD_items_current_Aggression_sum',
                    'CD_items_current_Destruction_sum',
                    'CD_items_current_RuleViolation_sum',
                    'CD_items_current_DeceitfulnessTheft_sum'
                ]
            ].sum(axis=1, min_count=1)

            df_subset = df_subset.merge(clinical_df, on='ID', how='left')

            # ============================================================
            # COMBAT COVARIATES (BIOLOGY PRESERVED)
            # ============================================================

            covars = df_subset[
                [
                    'Sex',
                    'centre',
                    'Age',
                    'ICU_IMPUTED_total_sum_imp',
                    'CD_total',
                    'ADHD_current_Impulsivity_Hyperactivity_count',
                    'ODD_items_fulfilled_current',
                    'KSLDC_DIAG_Dep_acute',
                    'KSLDC_DIAG_Anx_acute',
                    'KSLDC_DIAG_PTSD_acute'
                ]
            ].rename(columns={
                'Sex': 'gender',
                'centre': 'batch',
                'ICU_IMPUTED_total_sum_imp': 'ICU',
                'ADHD_current_Impulsivity_Hyperactivity_count': 'ADHD',
                'ODD_items_fulfilled_current': 'ODD',
                'KSLDC_DIAG_Dep_acute': 'Depression',
                'KSLDC_DIAG_Anx_acute': 'Anxiety',
                'KSLDC_DIAG_PTSD_acute': 'PTSD'
            })

            covars = covars.dropna()
            df_subset = df_subset.loc[covars.index]

            logging.info(f"N after Combat covariate filtering: {len(df_subset)}")

            # ============================================================
            # FEATURES TO HARMONIZE (COGNITIVE ONLY)
            # ============================================================

            features = df_subset.drop(columns=[
                'ID', 'CD_OnsetType',
                'Sex', 'centre', 'Age', 'IQ',
                'ICU_IMPUTED_total_sum_imp', 'CD_total',
                'ADHD_current_Impulsivity_Hyperactivity_count',
                'ODD_items_fulfilled_current',
                'KSLDC_DIAG_Dep_acute',
                'KSLDC_DIAG_Anx_acute',
                'KSLDC_DIAG_PTSD_acute',
                'KSLDC_DIAG_OCD_acute'
            ])

            # ============================================================
            # RUN NEUROCOMBAT
            # ============================================================

            if site_normalization:
                if covars['gender'].nunique() > 1 and covars['batch'].nunique() > 1:

                    logging.info("Running neuroCombat (site normalization ON)")

                    combat_out = neuroCombat(
                        dat=features.T,
                        covars=covars,
                        batch_col='batch',
                        categorical_cols=['gender']
                    )

                    harmonized = combat_out["data"].T

                    df_harmonized = pd.DataFrame(
                        harmonized,
                        index=features.index,
                        columns=features.columns
                    )

                else:
                    logging.warning("Skipping neuroCombat: insufficient variability")
                    df_harmonized = features

            else:
                logging.info("Site normalization OFF — using raw features")
                df_harmonized = features

            # ============================================================
            # SCALE FEATURES
            # ============================================================

            scaler = StandardScaler()

            df_scaled = pd.DataFrame(
                scaler.fit_transform(df_harmonized),
                index=df_harmonized.index,
                columns=df_harmonized.columns
            ).clip(-3, 3)

            # ============================================================
            # BUILD METADATA
            # ============================================================

            meta_cols = [
                'ID', 'Sex', 'Age', 'IQ',
                'CD_total',
                'ICU_IMPUTED_total_sum_imp',
                'ADHD_current_Impulsivity_Hyperactivity_count',
                'ODD_items_fulfilled_current',
                'KSLDC_DIAG_Dep_acute',
                'KSLDC_DIAG_Anx_acute',
                'KSLDC_DIAG_PTSD_acute',
                'KSLDC_DIAG_OCD_acute'
            ]

            meta = df_subset[meta_cols].copy()

            meta.rename(columns={
                'ICU_IMPUTED_total_sum_imp': 'Callousness',
                'KSLDC_DIAG_Dep_acute': 'Depression',
                'KSLDC_DIAG_Anx_acute': 'Anxiety',
                'KSLDC_DIAG_PTSD_acute': 'PTSD',
                'KSLDC_DIAG_OCD_acute': 'OCD',
                'ADHD_current_Impulsivity_Hyperactivity_count': 'ADHD',
                'ODD_items_fulfilled_current': 'ODD'
            }, inplace=True)

            meta['Group'] = np.where(
                pd.to_numeric(meta['ID'], errors='coerce') <= 542,
                'CD',
                'Control'
            )

            meta['CD_OnsetType'] = df_subset['CD_OnsetType'].values

            meta['Internalising_bin'] = np.where(
                (meta['Anxiety'] == 1) | (meta['Depression'] == 1),
                1,
                np.where(
                    meta[['Anxiety', 'Depression']].isna().any(axis=1),
                    np.nan,
                    0
                )
            )

            self.df_metadata = meta


            # ============================================================
            # FINAL DATASET
            # ============================================================

            df_clean = df_scaled.copy()

            df_clean.insert(0, 'ID', df_subset['ID'].values)

            if only_cd:
                df_clean = df_clean[
                    pd.to_numeric(df_clean['ID'], errors='coerce') <= 542
                    ]

            df_clean.to_csv(
                "/Users/adaml/Desktop/CODE/Data/FemNAT_cleaned_encoded.csv",
                index=False
            )

            return df_clean

        except Exception as e:
            logging.error(f"Preprocessing failed: {e}")
            raise

