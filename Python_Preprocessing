    def compare_root_clusters_categorical(
            self,
            df: pd.DataFrame,
            variable: str
    ):
        """
        Chi-square + Cramér's V for a categorical clinical variable vs Root_Cluster.
        """

        table = pd.crosstab(df["Root_Cluster"], df[variable])

        if table.size == 0 or table.to_numpy().sum() == 0:
            logging.warning(f"No data for categorical variable '{variable}'.")
            return None

        chi2, p, dof, expected = chi2_contingency(table)

        n = table.to_numpy().sum()
        k = min(table.shape)
        cramers_v = np.sqrt(chi2 / (n * (k - 1))) if k > 1 else np.nan

        logging.info(
            f"[Categorical] {variable}: chi2={chi2:.2f}, p={p:.4f}, "
            f"Cramér's V={cramers_v:.3f}"
        )

        return {
            "variable": variable,
            "chi2": chi2,
            "p": p,
            "cramers_v": cramers_v,
            "table": table
        }

    def run_root_cluster_clinical_analysis(
            self,
            outpath="Results/Root_Clinical_Stats.xlsx"
    ):

        if not hasattr(self, "l1_clusters"):
            raise RuntimeError("Run run_analysis() first")

        rows = []
        for unit, ids in self.l1_clusters.items():
            for sid in ids:
                rows.append({
                    "ID": sid,
                    "Root_Cluster": int(unit)
                })

        df_assign = pd.DataFrame(rows)

        df = (
            df_assign
            .merge(self.df_metadata, on="ID", how="left")
            .merge(self.df_clean, on="ID", how="left")
        )

        cat_vars = ["ODD", "ADHD", "Depression", "Anxiety", "PTSD", "OCD"]
        cont_vars = ["CD_total", "Callousness", "Age_raw"]

        diag_rows, cont_rows = [], []

        # CATEGORICAL (same as before)
        for var in cat_vars:
            table = pd.crosstab(df["Root_Cluster"], df[var])
            chi2, p, _, _ = chi2_contingency(table)

            n = table.values.sum()
            k = min(table.shape)
            V = np.sqrt(chi2 / (n * (k - 1))) if k > 1 else np.nan

            row = {"Variable": var, "Chi2": chi2, "p": p, "CramersV": V}
            for cl in table.index:
                row[f"{cl}_%"] = (
                        table.loc[cl].get(1, 0) / table.loc[cl].sum() * 100
                )
            diag_rows.append(row)

        # CONTINUOUS (same as before)
        for var in cont_vars:
            groups = [
                g.dropna().values
                for _, g in df.groupby("Root_Cluster")[var]
                if len(g.dropna()) > 0
            ]

            if len(groups) < 2:
                continue

            F, p = f_oneway(*groups)

            all_vals = df[var].dropna().values
            gm = all_vals.mean()
            ssb = sum(len(g) * (g.mean() - gm) ** 2 for g in groups)
            sst = ((all_vals - gm) ** 2).sum()
            eta2 = ssb / sst if sst > 0 else np.nan

            row = {"Variable": var, "F": F, "p": p, "Eta2": eta2}

            for cl, mean in df.groupby("Root_Cluster")[var].mean().items():
                row[f"{cl}_Mean"] = mean

            cont_rows.append(row)

        with pd.ExcelWriter(outpath) as w:
            pd.DataFrame(diag_rows).to_excel(w, "Categorical", index=False)
            pd.DataFrame(cont_rows).to_excel(w, "Continuous", index=False)

        logging.info(f"Root clinical analysis written  {outpath}")

    def write_root_cluster_summary(
            self,
            outpath="Results/Root_Cluster_Summary.xlsx"
    ):

        if not hasattr(self, "l1_clusters"):
            raise RuntimeError("Run run_analysis() first")

        rows = []
        for unit, ids in self.l1_clusters.items():
            for sid in ids:
                rows.append({
                    "ID": sid,
                    "Root_Cluster": int(unit)
                })

        df_assign = pd.DataFrame(rows)

        df = (
            df_assign
            .merge(self.df_metadata, on="ID", how="left")
            .merge(self.df_clean, on="ID", how="left")
        )

        neuropsych_vars = [
            c for c in self.df_clean.columns
            if c not in ["ID", "IQ"]
        ]

        clinical_vars = [
            "CD_total", "Callousness", "ODD", "ADHD",
            "Depression", "Anxiety", "PTSD", "OCD",
            "Internalising_bin"
        ]

        summary_rows = []

        for clust, sub in df.groupby("Root_Cluster"):

            row = {"Cluster": clust, "N": len(sub)}

            for var in neuropsych_vars:
                row[f"Mean_{var}"] = sub[var].mean()

            for var in clinical_vars:
                if var not in sub.columns:
                    continue

                if sub[var].dropna().isin([0, 1]).all():
                    row[f"{var}_%"] = sub[var].mean() * 100
                else:
                    row[f"Mean_{var}"] = sub[var].mean()

            row["Mean_Age"] = sub["Age_raw"].mean()
            row["Mean_IQ"] = sub["IQ"].mean()

            sex_counts = sub["Sex"].value_counts(normalize=True) * 100
            row["Male_%"] = sex_counts.get(2, 0)
            row["Female_%"] = sex_counts.get(1, 0)

            summary_rows.append(row)

        summary_df = pd.DataFrame(summary_rows)
        summary_df.to_excel(outpath, index=False)

        logging.info(f"Root cluster summary written  {outpath}")
        return summary_df

    def _plot_spider_profiles_layer1(
            self,
            features: pd.DataFrame,
            clusters: Dict[int, List[str]]
    ):

        id2idx = {id_: i for i, id_ in enumerate(self.df_clean['ID'])}

        cols = features.columns.tolist()
        N = len(cols)
        angles = np.linspace(0, 2 * np.pi, N, endpoint=False).tolist()
        angles += angles[:1]

        for unit, ids in clusters.items():

            idxs = [id2idx[i] for i in ids if i in id2idx]

            if len(idxs) < 2:
                continue

            vals = features.iloc[idxs].mean(axis=0).tolist()
            vals += vals[:1]

            fig, ax = plt.subplots(figsize=(6, 6), subplot_kw={'polar': True})

            ax.plot(angles, vals, linewidth=2)
            ax.fill(angles, vals, alpha=0.25)

            ax.set_thetagrids(np.degrees(angles[:-1]), cols, fontsize=8)
            ax.set_ylim(-2, 3)
            ax.set_yticks([-2, 0, 2])
            ax.set_title(f"Root Cluster {unit}", y=1.1)

            outfile = f"Results/spider_L1_{unit}.png"
            plt.savefig(outfile, bbox_inches="tight", dpi=150)
            plt.close()

            print(f"Saved: {outfile}")

