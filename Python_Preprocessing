def compute_root_cluster_stability(
    cv_path="Results/CV_RootCluster_Assignments.csv",
    out_path="Results/CV_RootCluster_Stability.csv"
):

    df = pd.read_csv(cv_path)

    rows = []

    for sid, sub in df.groupby("ID"):

        labs = sub["Root_Cluster"].dropna()
        total = len(sub)

        if len(labs) == 0:
            stab = np.nan
            common = None
        else:
            vals, cnts = np.unique(labs, return_counts=True)
            common = vals[np.argmax(cnts)]
            stab = cnts.max() / total

        rows.append({
            "ID": sid,
            "MostCommon_Root": common,
            "Stability": stab,
            "NumRepeats": total,
            "NumAssigned": len(labs)
        })

    out = pd.DataFrame(rows).sort_values("Stability", ascending=False)
    out.to_csv(out_path, index=False)

    print("\n=== Root-level stability ===")
    print(out["Stability"].describe())

    return out

