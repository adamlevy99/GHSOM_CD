    def _convert_matlab_ghmap(self, ghMap, X):

        """
        Properly reconstruct MATLAB GHSOM hierarchy using:
            ghMap.parent
            ghMap.parent_unit
            ghMap.layer
        """

        # -----------------------------
        # Normalize MATLAB cell arrays
        # -----------------------------
        sMap = ghMap.sMap
        parent = ghMap.parent
        parent_unit = ghMap.parent_unit
        layer = ghMap.layer

        # Convert to Python lists if needed
        if not isinstance(sMap, (list, np.ndarray)):
            sMap = [sMap]
        if isinstance(sMap, np.ndarray):
            sMap = list(sMap.flatten())

        parent = np.array(parent).flatten()
        parent_unit = np.array(parent_unit).flatten()
        layer = np.array(layer).flatten()

        # -----------------------------
        # Root map (MATLAB index 1)
        # -----------------------------
        # Find true root
        root_idx = np.where(parent == 0)[0][0]
        root_sMap = sMap[root_idx]

        root_codebook = np.array(root_sMap.codebook)
        n_root_units = root_codebook.shape[0]

        # Compute BMUs
        d2_root = np.sum((X[:, None, :] - root_codebook[None, :, :]) ** 2, axis=2)
        root_bmus = np.argmin(d2_root, axis=1)

        # Build children list
        children = [None] * n_root_units

        for i in range(len(sMap)):

            if i == root_idx:
                continue

            if layer[i] != 2:
                continue

            # Must be child of actual root
            if parent[i] != (root_idx + 1):
                continue

            root_unit_index = int(parent_unit[i]) - 1

            child_map = sMap[i]

            children[root_unit_index] = {
                "codebook": np.array(child_map.codebook),
                "topol": {
                    "msize": tuple(child_map.topol.msize)
                }
            }

        # -----------------------------
        # Final root structure
        # -----------------------------
        root_struct = {
            "codebook": root_codebook,
            "bmus": root_bmus,
            "children": children,
            "topol": {
                "msize": tuple(root_sMap.topol.msize)
            }
        }

        return root_struct

    def _extract_layer1_clusters(
            self,
            struct: Dict[str, Any],
            labels: np.ndarray
    ) -> Dict[int, List[str]]:

        clusters = {}

        root_bmus = struct['root_map']['bmus']

        for unit in np.unique(root_bmus):
            ids = labels[root_bmus == unit]
            clusters[int(unit)] = ids.tolist()

        return clusters

